# 빌드 결과물 (build.bat으로 생성, 배포는 Releases의 BusDepot.zip으로)
*.exe
*.exe.old
*.pdb
*.zip

# 사용자 설정 (개인 경로가 들어감)
obj2x.ini

# 자동 업데이트가 만드는 백업 폴더
obj2x_backup/

# 테스트용 모델/변환 결과
*.obj
*.mtl
*.x
*.o3d

# --selftest 결과 / --shots 스크린샷
obj2x_selftest.txt
*.png
# README에 쓰는 화면 (obj2x.exe --readme-shots로 생성)
!docs/images/*.png
!docs/images/*/*.png

# Python
__pycache__/
*.pyc

# Claude Code 개인 설정
.claude/settings.local.json

# 에디터 / OS
.vs/
.vscode/
Thumbs.db
desktop.ini

# 번역 검수용 표 (L 문구표에서 생성)
translation_review.csv
shared/lang/_template.json

# MiSans: license forbids redistribution; users install it themselves
shared/fonts/MiSans*
windows/fonts/MiSans*
mac/**/MiSans*

# Bus Depot (v2.7.3부터의 이름)
BusDepot.exe
BusDepot.ini
BusDepot_backup/
BusDepot_selftest.txt
BusDepot_fps.txt

# windows/build.bat이 exe 옆으로 복사하는 것 (원본은 shared/)
windows/fonts/
windows/BusDepot.py

# 맥 버전 빌드 결과 (dotnet)
mac/bin/
mac/obj/
mac/publish/
*.app/

# 지울 것 모아 두는 곳 (직접 확인하고 지움)
useless/

# build.py 결과
dist/
app/bin/
app/obj/
