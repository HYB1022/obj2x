<ScrollViewer xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Obj2x.UI"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <!-- OMSI 스플라인 만들기: 차선/인도 값으로 도로 단면(.sli)을 만들어 Splines에 저장 -->
  <StackPanel Margin="24,20,24,28" MaxWidth="820">
    <TextBlock Text="{ui:Tr nav_spline}" Theme="{StaticResource PageTitle}" Margin="8,4,0,4"/>
    <TextBlock Text="{ui:Tr spl_intro}" Theme="{StaticResource DevSub}" Margin="8,0,8,6"/>
    <TextBlock Text="{ui:Tr spl_sec_view}" Theme="{StaticResource DevCaption}"/>
    <Border Theme="{StaticResource DevCard}">
      <StackPanel>
        <Button Theme="{StaticResource DevRow}" Command="{Binding OpenSliCmd}">
          <DockPanel>
            <Path DockPanel.Dock="Right" Theme="{StaticResource DevChevron}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_view_file}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{Binding SliPathText}" Theme="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Button>
      </StackPanel>
    </Border>
    <Border Theme="{StaticResource DevCard}" Margin="0,14,0,0" Padding="10">
      <Grid Height="380">
        <ui:ModelView Parts="{Binding SliParts}" Scene="{Binding SliScene}" Overlay="{Binding SliOverlay}"/>
        <TextBlock Text="{ui:Tr spl_view_empty}" Theme="{StaticResource DevSub}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                   TextAlignment="Center" Margin="40,0" IsVisible="{Binding SliEmpty}"/>
      </Grid>
    </Border>
    <TextBlock Text="{Binding SliInfo}" Theme="{StaticResource DevSub}" Margin="24,8,24,0" TextWrapping="Wrap"/>
    <TextBlock Text="{ui:Tr spl_view_legend}" Theme="{StaticResource DevSub}" Margin="24,2,24,0" TextWrapping="Wrap"/>
    <TextBlock Text="{ui:Tr view_controls}" Theme="{StaticResource DevSub}" Margin="24,2,24,0" TextWrapping="Wrap"/>
    <TextBlock Text="{ui:Tr spl_sec_preview}" Theme="{StaticResource DevCaption}"/>
    <Border Theme="{StaticResource DevCard}" Padding="0,18,0,16">
      <StackPanel>
        <ui:SplinePreview Spec="{Binding SplSpec}" Version="{Binding SplVersion}"/>
        <TextBlock Text="{Binding SplSummary}" Theme="{StaticResource DevSub}" Margin="24,10,24,0"/>
        <TextBlock Text="{Binding SplError}" Foreground="{DynamicResource Bad}" FontSize="12.5" Margin="24,4,24,0"/>
      </StackPanel>
    </Border>
    <TextBlock Text="{ui:Tr spl_sec_road}" Theme="{StaticResource DevCaption}"/>
    <Border Theme="{StaticResource DevCard}">
      <StackPanel>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <ui:NumBox DockPanel.Dock="Right" Value="{Binding SplLanes}" Minimum="1" Maximum="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_lanes}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_lanes_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="m" Theme="{StaticResource DevValue}" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" Margin="16,0,0,0" TextAlignment="Right" Text="{Binding SplLaneW, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_lanew}" Theme="{StaticResource DevTitle}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <ui:Segmented DockPanel.Dock="Right" Items="two=spl_two;one=spl_one" Value="{Binding SplDir}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_dir}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_dir_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}" IsVisible="{Binding SplOdd}">
          <DockPanel>
            <ui:Segmented DockPanel.Dock="Right" Items="left=spl_extra_left;right=spl_extra_right" Value="{Binding SplExtra}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_extra}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_extra_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{ui:Tr btn_browse}" Theme="{StaticResource BtnSmall}" VerticalAlignment="Center" Command="{Binding PickRoadTexCmd}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{ui:Tr spl_tex_reset}" Theme="{StaticResource BtnSmall}" VerticalAlignment="Center" Command="{Binding ClearRoadTexCmd}" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_road_tex}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{Binding SplRoadTexText}" Theme="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <ui:Segmented DockPanel.Dock="Right" Items="road=spl_fit_road;lane=spl_fit_lane" Value="{Binding SplTexFit}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_fit}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_fit_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="m" Theme="{StaticResource DevValue}" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" Margin="16,0,0,0" TextAlignment="Right" Text="{Binding SplRoadRepeat, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_repeat}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_repeat_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
      </StackPanel>
    </Border>
    <TextBlock Text="{ui:Tr spl_sec_walk}" Theme="{StaticResource DevCaption}"/>
    <Border Theme="{StaticResource DevCard}">
      <StackPanel>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="m" Theme="{StaticResource DevValue}" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" Margin="16,0,0,0" TextAlignment="Right" Text="{Binding SplWalkL, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_walkl}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_walk_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="m" Theme="{StaticResource DevValue}" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" Margin="16,0,0,0" TextAlignment="Right" Text="{Binding SplWalkR, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_walkr}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_walk_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="m" Theme="{StaticResource DevValue}" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" Margin="16,0,0,0" TextAlignment="Right" Text="{Binding SplCurb, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_curb}" Theme="{StaticResource DevTitle}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{ui:Tr btn_browse}" Theme="{StaticResource BtnSmall}" VerticalAlignment="Center" Command="{Binding PickWalkTexCmd}" Margin="8,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="{ui:Tr spl_tex_reset}" Theme="{StaticResource BtnSmall}" VerticalAlignment="Center" Command="{Binding ClearWalkTexCmd}" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_walk_tex}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{Binding SplWalkTexText}" Theme="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="m" Theme="{StaticResource DevValue}" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Right" Width="80" VerticalAlignment="Center" Margin="16,0,0,0" TextAlignment="Right" Text="{Binding SplWalkRepeat, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_tile}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_tile_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
      </StackPanel>
    </Border>
    <TextBlock Text="{ui:Tr spl_sec_save}" Theme="{StaticResource DevCaption}"/>
    <Border Theme="{StaticResource DevCard}">
      <StackPanel>
        <Button Theme="{StaticResource DevRow}" Command="{Binding BrowseOmsiCmd}">
          <DockPanel>
            <Path DockPanel.Dock="Right" Theme="{StaticResource DevChevron}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr omsi_dir}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{Binding OmsiDirText}" Theme="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Button>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding SplFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_folder}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr spl_folder_sub}" Theme="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Theme="{StaticResource DevStatic}">
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding SplName, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr spl_name}" Theme="{StaticResource DevTitle}"/>
              <TextBlock Text="{Binding SplOutText}" Theme="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
      </StackPanel>
    </Border>
    <Button Content="{ui:Tr spl_make}" Theme="{StaticResource BtnPrimary}" Command="{Binding MakeSplCmd}" HorizontalAlignment="Right" Height="40" MinWidth="140" Margin="0,22,8,0"/>
  </StackPanel>
</ScrollViewer>
