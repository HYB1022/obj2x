<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Obj2x.UI;assembly=obj2x"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <!-- 개발자 옵션 (HyperOS 설정 화면 모양). 정보 화면의 버전을 7번 누르면 메뉴에 나타난다 -->
  <StackPanel Margin="24,20,24,28" MaxWidth="820">
    <TextBlock Text="{ui:Tr nav_dev}" FontSize="30" FontWeight="Bold" Margin="8,4,0,18"/>
    <!-- 전체 스위치: 끄면 메뉴가 사라지고 정보 화면으로 돌아간다 -->
    <Border Style="{StaticResource DevCard}">
      <StackPanel>
        <DockPanel Margin="24,14">
          <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding DevMode}" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{ui:Tr dev_master}" Style="{StaticResource DevTitle}"/>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
    <StackPanel IsEnabled="{Binding DevMode}">
      <TextBlock Text="{ui:Tr dev_grp_update}" Style="{StaticResource DevCaption}"/>
      <Border Style="{StaticResource DevCard}">
        <StackPanel>
          <Button Style="{StaticResource DevRow}" Command="{Binding BugReportCmd}">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{ui:Tr dev_bug}" Style="{StaticResource DevTitle}"/>
                <TextBlock Text="{ui:Tr dev_bug_sub}" Style="{StaticResource DevSub}"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource DevRow}" Command="{Binding DevCheckCmd}">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{ui:Tr dev_check}" Style="{StaticResource DevTitle}"/>
                <TextBlock Text="{Binding DevCheckValue}" Style="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource DevRow}" Command="{Binding ReinstallCmd}">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{ui:Tr dev_reinstall}" Style="{StaticResource DevTitle}"/>
                <TextBlock Text="{ui:Tr dev_reinstall_sub}" Style="{StaticResource DevSub}"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
      </Border>
      <TextBlock Text="{ui:Tr dev_grp_debug}" Style="{StaticResource DevCaption}"/>
      <Border Style="{StaticResource DevCard}">
        <StackPanel>
          <Button Style="{StaticResource DevRow}" Command="{Binding SelfTestCmd}">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{ui:Tr dev_selftest}" Style="{StaticResource DevTitle}"/>
                <TextBlock Text="{Binding SelfTestValue}" Style="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource DevRow}" Command="{Binding LangReloadCmd}">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{ui:Tr dev_lang_reload}" Style="{StaticResource DevTitle}"/>
                <TextBlock Text="{ui:Tr dev_lang_reload_sub}" Style="{StaticResource DevSub}"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource DevRow}" Command="{Binding OpenIniCmd}">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{ui:Tr dev_ini}" Style="{StaticResource DevTitle}"/>
                <TextBlock Text="{Binding InfoIni}" Style="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource DevRow}" Command="{Binding WelcomeAgainCmd}">
            <DockPanel>
              <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{ui:Tr dev_welcome}" Style="{StaticResource DevTitle}"/>
                <TextBlock Text="{ui:Tr dev_welcome_sub}" Style="{StaticResource DevSub}"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </StackPanel>
      </Border>
      <TextBlock Text="{ui:Tr dev_grp_draw}" Style="{StaticResource DevCaption}"/>
      <Border Style="{StaticResource DevCard}">
        <StackPanel>
          <DockPanel Margin="24,14">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding DevFps}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr dev_fps}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr dev_fps_sub}" Style="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="24,14">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding DevBounds}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr dev_bounds}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr dev_bounds_sub}" Style="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="24,14">
            <ComboBox DockPanel.Dock="Right" Style="{StaticResource DevSelect}" ItemsSource="{Binding AnimChoices}" DisplayMemberPath="Name"
                      SelectedValuePath="Code" SelectedValue="{Binding DevAnim}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr dev_anim}" Style="{StaticResource DevTitle}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{ui:Tr dev_grp_convert}" Style="{StaticResource DevCaption}"/>
      <Border Style="{StaticResource DevCard}">
        <StackPanel>
          <DockPanel Margin="24,14">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding DevVerbose}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr dev_verbose}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr dev_verbose_sub}" Style="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{ui:Tr dev_grp_info}" Style="{StaticResource DevCaption}"/>
      <Border Style="{StaticResource DevCard}">
        <StackPanel>
          <DockPanel Margin="24,15">
            <TextBlock DockPanel.Dock="Right" Text="{Binding InfoRuntime}" Style="{StaticResource DevValue}" MaxWidth="380"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr dev_runtime}" Style="{StaticResource DevTitle}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="24,15">
            <TextBlock DockPanel.Dock="Right" Text="{Binding InfoRender}" Style="{StaticResource DevValue}" MaxWidth="380"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr dev_render}" Style="{StaticResource DevTitle}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="24,15">
            <TextBlock DockPanel.Dock="Right" Text="{Binding InfoScale}" Style="{StaticResource DevValue}" MaxWidth="380"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr dev_scale}" Style="{StaticResource DevTitle}"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="24,15">
            <TextBlock DockPanel.Dock="Right" Text="{Binding InfoPath}" Style="{StaticResource DevValue}" MaxWidth="380"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr dev_path}" Style="{StaticResource DevTitle}"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</ScrollViewer>
