<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Obj2x.UI;assembly=BusDepot">
  <!-- 공통 스타일. 색은 모두 Theme.cs가 넣는 브러시({DynamicResource 이름})를 쓴다. -->
  <BooleanToVisibilityConverter x:Key="Vis"/>

  <!-- 글자 -->
  <Style x:Key="TTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="TH2" TargetType="TextBlock"><Setter Property="FontSize" Value="14.67"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="TBold" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="TSub" TargetType="TextBlock"><Setter Property="FontSize" Value="11.33"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
  <Style x:Key="TTiny" TargetType="TextBlock"><Setter Property="FontSize" Value="10.67"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>

  <!-- 카드 / 구분선: HyperOS처럼 테두리 없는 둥근 카드 -->
  <Style x:Key="CardBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="CornerRadius" Value="20"/>
  </Style>
  <Style x:Key="Div" TargetType="Rectangle">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Fill" Value="{DynamicResource Divider}"/>
  </Style>

  <!-- 상태 점 (DataContext의 StatusState: ok / warn / busy) -->
  <Style x:Key="Dot" TargetType="Ellipse">
    <Setter Property="Width" Value="10"/><Setter Property="Height" Value="10"/>
    <Setter Property="Fill" Value="{DynamicResource Warn}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding StatusState}" Value="ok"><Setter Property="Fill" Value="{DynamicResource Ok}"/></DataTrigger>
      <DataTrigger Binding="{Binding StatusState}" Value="busy"><Setter Property="Fill" Value="{DynamicResource Busy}"/></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 버튼: 바탕 위에 호버 색 층이 부드럽게 나타나고, 누르면 누른 지점에서 물결이 퍼진다. 모서리는 ui:Behave.Radius, 호버 색은 ui:Behave.Hover -->
  <ControlTemplate x:Key="BtnTpl" TargetType="Button">
    <Grid>
      <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="{Binding Path=(ui:Behave.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
      <Border x:Name="hov" Background="{Binding Path=(ui:Behave.Hover), RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"
              CornerRadius="{Binding Path=(ui:Behave.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
      <ui:Ripple CornerRadius="{Binding Path=(ui:Behave.Radius), RelativeSource={RelativeSource TemplatedParent}}"/>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="ui:Anim.Opacity" Value="1"/></Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="bg" Property="Background" Value="{DynamicResource DisBg}"/>
        <Setter TargetName="hov" Property="Visibility" Value="Collapsed"/>
        <Setter Property="Foreground" Value="{DynamicResource DisText}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="BtnNormal" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
    <Setter Property="Background" Value="{DynamicResource Btn}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="ui:Behave.Hover" Value="{DynamicResource BtnHov}"/>
    <Setter Property="ui:Behave.Radius" Value="8"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="MinWidth" Value="72"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnNormal}">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="ui:Behave.Hover" Value="{DynamicResource AccentHov}"/>
  </Style>
  <Style x:Key="BtnBanner" TargetType="Button" BasedOn="{StaticResource BtnNormal}">
    <Setter Property="Background" Value="{DynamicResource BnBtnBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource BnBtnFg}"/>
    <Setter Property="ui:Behave.Hover" Value="{DynamicResource BnBtnHov}"/>
  </Style>
  <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnNormal}">
    <Setter Property="Height" Value="28"/>
    <Setter Property="ui:Behave.Radius" Value="6"/>
    <Setter Property="MinWidth" Value="0"/>
  </Style>
  <!-- 탭 버튼: Tag가 on이면 강조색 -->
  <Style x:Key="BtnTab" TargetType="Button" BasedOn="{StaticResource BtnSmall}">
    <Style.Triggers>
      <Trigger Property="Tag" Value="on">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="ui:Behave.Hover" Value="{DynamicResource AccentHov}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- 목록 줄 버튼 (최근 폴더) -->
  <Style x:Key="BtnRow" TargetType="Button" BasedOn="{StaticResource BtnNormal}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="ui:Behave.Hover" Value="{DynamicResource Btn}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="hov" Background="{DynamicResource Btn}" CornerRadius="8" Margin="0,1" Opacity="0"/>
            <ui:Ripple CornerRadius="8" Margin="0,1"/>
            <ContentPresenter/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="ui:Anim.Opacity" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 토글 (CheckBox): 손잡이가 미끄러지고 바탕이 강조색으로 바뀐다 -->
  <Style x:Key="Toggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="46" Height="24" Background="Transparent">
            <Border CornerRadius="10" Margin="2" Background="{DynamicResource ToggleOff}"/>
            <Border x:Name="on" CornerRadius="10" Margin="2" Background="{DynamicResource Accent}" Opacity="0"/>
            <Ellipse x:Name="knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="6,0,0,0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="knob" Property="ui:Anim.X" Value="20"/>
              <Setter TargetName="on" Property="ui:Anim.Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 체크 표시 + 글자 -->
  <Style x:Key="Chk" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="box" Width="17" Height="17" CornerRadius="4" BorderThickness="1.5" HorizontalAlignment="Left"
                    BorderBrush="{DynamicResource Muted}" Background="{DynamicResource Card}"/>
            <Path x:Name="mark" Width="17" Height="17" HorizontalAlignment="Left" Data="M 4.5,9 L 7.5,12 L 13,5.5" Stroke="White" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="mark" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisText}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 라디오 (선택 대화 상자) -->
  <Style x:Key="Radio" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="ring" Width="18" Height="18" StrokeThickness="2" Stroke="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="7,0,0,0" Opacity="0"/>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Accent}"/>
              <Setter TargetName="dot" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 입력 상자 -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Input}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputBdr}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="28"/>
    <!-- 125% 등 배율에서 카드 안 StackPanel이 1px 안쪽으로 잘려 아래 테두리가 사라지는 것을 막는다 -->
    <Setter Property="Margin" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource DisBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LogBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Height" Value="NaN"/>
    <Setter Property="FontFamily" Value="Consolas"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Padding" Value="4,4"/>
  </Style>

  <!-- 드롭다운 (언어 선택 등): 둥근 상자 + 아래로 펼쳐지는 카드, 고른 항목에 체크 표시 -->
  <Style x:Key="DropItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="10,0" Height="34">
            <Grid>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,24,0"/>
              <Path x:Name="check" Data="M 0,4.5 L 3.5,8 L 10,1" Stroke="{DynamicResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="check" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Drop" TargetType="ComboBox">
    <Setter Property="Height" Value="32"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource DropItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="{DynamicResource Input}" BorderBrush="{DynamicResource InputBdr}" BorderThickness="1" CornerRadius="8"/>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Muted}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Path IsHitTestVisible="False" Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,13,0" RenderTransformOrigin="0.5,0.5" x:Name="arrow"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" VerticalOffset="4"
                   PopupAnimation="None" ui:Anim.PopIn="True" Focusable="False">
              <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBdr}" BorderThickness="1" CornerRadius="10" Padding="4"
                      Margin="0,0,10,12" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18"/></Border.Effect>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="arrow" Property="ui:Anim.Angle" Value="180"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 둥근 화살표 버튼 (환영 화면의 시작) -->
  <Style x:Key="BtnRound" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Width" Value="64"/><Setter Property="Height" Value="64"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse Fill="{DynamicResource Accent}">
              <Ellipse.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.22"/></Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="hov" Fill="{DynamicResource AccentHov}" Opacity="0"/>
            <ui:Ripple CornerRadius="32"/>
            <Path Data="M 0,8 L 18,8 M 11,1 L 18,8 L 11,15" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="ui:Anim.Opacity" Value="1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 개발자 옵션 (HyperOS 설정 화면 모양): 큰 제목, 둥근 카드, 제목/설명 줄, 오른쪽에 스위치·화살표·값 선택 -->
  <Style x:Key="DevCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="CornerRadius" Value="20"/>
  </Style>
  <Style x:Key="DevCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Margin" Value="24,18,0,8"/>
  </Style>
  <Style x:Key="DevTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisText}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DevSub" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisText}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DevValue" TargetType="TextBlock" BasedOn="{StaticResource DevSub}">
    <Setter Property="Margin" Value="16,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="DevChevron" TargetType="Path">
    <Setter Property="Data" Value="M 0,0 L 5.5,5.5 L 0,11"/>
    <Setter Property="Stroke" Value="{DynamicResource Muted}"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="14,0,0,0"/>
  </Style>
  <!-- 누를 수 있는 줄: 마우스를 올리면 옅게 칠해지고, 누르면 물결이 퍼진다 -->
  <Style x:Key="DevRow" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="hov" Background="{DynamicResource Btn}" Opacity="0"/>
            <ui:Ripple/>
            <ContentPresenter Margin="24,17"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="ui:Anim.Opacity" Value="0.6"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 누르는 기능은 없지만 마우스를 올리면 옅게 칠해지고, 누르면 물결이 퍼지는 줄 (앱 정보, 오른쪽에 컨트롤이 있는 줄).
       줄 안의 컨트롤을 누를 때는 줄 물결이 생기지 않는다 (Ripple이 알아서 거른다) -->
  <Style x:Key="DevStatic" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid Background="Transparent">
            <Border x:Name="hov" Background="{DynamicResource Btn}" Opacity="0"/>
            <ui:Ripple/>
            <ContentPresenter Margin="24,17"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="ui:Anim.Opacity" Value="0.6"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 페이지 큰 제목 (HyperOS 설정 화면) -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="8,4,0,4"/>
  </Style>

  <!-- 스위치 줄 (CheckBox): 줄 어디를 눌러도 켜고 끈다. 내용 = 왼쪽 제목/설명 -->
  <Style x:Key="DevToggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Border x:Name="hov" Background="{DynamicResource Btn}" Opacity="0"/>
            <ui:Ripple/>
            <DockPanel Margin="24,17">
              <Grid x:Name="sw" DockPanel.Dock="Right" Width="46" Height="24" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border CornerRadius="10" Margin="2" Background="{DynamicResource ToggleOff}"/>
                <Border x:Name="on" CornerRadius="10" Margin="2" Background="{DynamicResource Accent}" Opacity="0"/>
                <Ellipse x:Name="knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="6,0,0,0"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="ui:Anim.Opacity" Value="0.6"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="knob" Property="ui:Anim.X" Value="20"/>
              <Setter TargetName="on" Property="ui:Anim.Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="sw" Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 값 선택 줄 (ComboBox): 왼쪽 제목(Tag), 오른쪽 값 + ⌃⌄. 줄 어디를 눌러도 목록이 펼쳐진다 -->
  <Style x:Key="DevSelect" TargetType="ComboBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource DropItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid Background="Transparent">
                    <Border x:Name="hov" Background="{DynamicResource Btn}" Opacity="0"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="ui:Anim.Opacity" Value="0.6"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ui:Ripple/>
            <DockPanel Margin="24,17" IsHitTestVisible="False">
              <StackPanel x:Name="val" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Muted}" TextElement.FontSize="13"/>
                <Path Data="M 0,4 L 4,0 L 8,4 M 0,9 L 4,13 L 8,9" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
              <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource DevTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" PlacementTarget="{Binding ElementName=val}" AllowsTransparency="True" Placement="Bottom"
                   HorizontalOffset="-60" VerticalOffset="10" PopupAnimation="None" ui:Anim.PopIn="True" Focusable="False">
              <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBdr}" BorderThickness="1" CornerRadius="14" Padding="4" Margin="0,0,10,12" MinWidth="200">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18"/></Border.Effect>
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 얇은 스크롤 막대 (라이트/다크 모두) -->
  <Style x:Key="ThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Dim}" CornerRadius="4" Margin="2" Opacity="0.7"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PageBtn" TargetType="RepeatButton">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PageBtn}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 얇은 진행 막대 -->
  <Style x:Key="Slim" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Minimum" Value="0"/>
    <Setter Property="Maximum" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{DynamicResource Divider}"/>
            <Border x:Name="PART_Indicator" Background="{DynamicResource Accent}" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 결과 표 -->
  <Style x:Key="HdrL" TargetType="GridViewColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="8,6">
            <TextBlock Text="{TemplateBinding Content}" FontWeight="Bold" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="HdrR" TargetType="GridViewColumnHeader" BasedOn="{StaticResource HdrL}">
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
  </Style>
  <Style x:Key="ResRow" TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="bd" Background="Transparent" Padding="0,3">
            <GridViewRowPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource Btn}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource NavPill}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="1"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="2"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Res" TargetType="ListView">
    <Setter Property="Background" Value="{DynamicResource Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputBdr}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ResRow}"/>
  </Style>
</ResourceDictionary>
