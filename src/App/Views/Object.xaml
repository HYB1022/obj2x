<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ui="clr-namespace:Obj2x.UI;assembly=BusDepot"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <!-- OMSI 오브젝트 만들기: 모델 폴더의 o3d로 .sco를 만들고 모델/텍스처를 Sceneryobjects로 복사 -->
  <StackPanel Margin="24,20,24,28" MaxWidth="820">
    <TextBlock Text="{ui:Tr nav_object}" Style="{StaticResource PageTitle}" Margin="8,4,0,4"/>
    <TextBlock Text="{ui:Tr obj_intro}" Style="{StaticResource DevSub}" Margin="8,0,8,6"/>
    <TextBlock Text="{ui:Tr obj_sec_models}" Style="{StaticResource DevCaption}"/>
    <Border Style="{StaticResource DevCard}">
      <StackPanel>
        <Button Style="{StaticResource DevRow}" Command="{Binding BrowseModelsCmd}">
          <DockPanel>
            <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr obj_models}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{Binding ObjModels}" Style="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Button>
        <ContentControl Style="{StaticResource DevStatic}" Visibility="{Binding ModelsEmpty, Converter={StaticResource Vis}}">
          <TextBlock Text="{ui:Tr obj_models_hint}" Style="{StaticResource DevSub}" Margin="0"/>
        </ContentControl>
        <ItemsControl ItemsSource="{Binding Models}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Style="{StaticResource DevToggle}" IsChecked="{Binding Checked}">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource DevTitle}"/>
                  <TextBlock Text="{Binding Sub}" Style="{StaticResource DevSub}"/>
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding ModelsText}" Style="{StaticResource DevSub}" Margin="24,8,0,0"/>
    <TextBlock Text="{ui:Tr obj_sec_object}" Style="{StaticResource DevCaption}"/>
    <Border Style="{StaticResource DevCard}">
      <StackPanel>
        <ContentControl Style="{StaticResource DevStatic}">
          <DockPanel>
            <ui:Segmented DockPanel.Dock="Right" Items="each=obj_mode_each;one=obj_mode_one" Value="{Binding ObjMode}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr obj_mode}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr obj_mode_sub}" Style="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Style="{StaticResource DevStatic}">
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding ObjName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ObjNameEnabled}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr obj_name}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr obj_name_sub}" Style="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
        <ContentControl Style="{StaticResource DevStatic}">
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding ObjGroup, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr obj_group}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{ui:Tr obj_group_sub}" Style="{StaticResource DevSub}"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
      </StackPanel>
    </Border>
    <TextBlock Text="{ui:Tr obj_sec_props}" Style="{StaticResource DevCaption}"/>
    <Border Style="{StaticResource DevCard}">
      <StackPanel>
        <CheckBox Style="{StaticResource DevToggle}" IsChecked="{Binding ObjColl}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{ui:Tr obj_coll}" Style="{StaticResource DevTitle}"/>
            <TextBlock Text="{ui:Tr obj_coll_sub}" Style="{StaticResource DevSub}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox Style="{StaticResource DevToggle}" IsChecked="{Binding ObjSurf}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{ui:Tr obj_surf}" Style="{StaticResource DevTitle}"/>
            <TextBlock Text="{ui:Tr obj_surf_sub}" Style="{StaticResource DevSub}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox Style="{StaticResource DevToggle}" IsChecked="{Binding ObjShadow}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{ui:Tr obj_shadow}" Style="{StaticResource DevTitle}"/>
            <TextBlock Text="{ui:Tr obj_shadow_sub}" Style="{StaticResource DevSub}"/>
          </StackPanel>
        </CheckBox>
        <CheckBox Style="{StaticResource DevToggle}" IsChecked="{Binding ObjFixed}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{ui:Tr obj_fixed}" Style="{StaticResource DevTitle}"/>
            <TextBlock Text="{ui:Tr obj_fixed_sub}" Style="{StaticResource DevSub}"/>
          </StackPanel>
        </CheckBox>
        <ComboBox Style="{StaticResource DevSelect}" Tag="{ui:Tr obj_alpha}" ItemsSource="{Binding AlphaChoices}" DisplayMemberPath="Name"
                  SelectedValuePath="Code" SelectedValue="{Binding ObjAlpha}"/>
      </StackPanel>
    </Border>
    <TextBlock Text="{ui:Tr obj_sec_save}" Style="{StaticResource DevCaption}"/>
    <Border Style="{StaticResource DevCard}">
      <StackPanel>
        <Button Style="{StaticResource DevRow}" Command="{Binding BrowseOmsiCmd}">
          <DockPanel>
            <Path DockPanel.Dock="Right" Style="{StaticResource DevChevron}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr omsi_dir}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{Binding OmsiDirText}" Style="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Button>
        <ContentControl Style="{StaticResource DevStatic}">
          <DockPanel>
            <TextBox DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Margin="16,0,0,0" Text="{Binding ObjFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{ui:Tr obj_folder}" Style="{StaticResource DevTitle}"/>
              <TextBlock Text="{Binding ObjOutText}" Style="{StaticResource DevSub}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </ContentControl>
      </StackPanel>
    </Border>
    <Button Content="{ui:Tr obj_make}" Style="{StaticResource BtnPrimary}" Command="{Binding MakeObjCmd}" HorizontalAlignment="Right" Height="40" MinWidth="140" Margin="0,22,8,0"/>
  </StackPanel>
</ScrollViewer>
